#!/usr/bin/env bash
set -eo pipefail

cd "$(git rev-parse --show-toplevel)"
staged_go_files=$(git diff --cached --name-only --diff-filter=ACMR -- '*.go')
if [[ -z "$staged_go_files" ]]; then
  printf 'No Go files staged; continuing to commit.\n'
  exit 0
fi

if ! command -v golangci-lint >/dev/null 2>&1; then
  printf 'golangci-lint v2 must be on PATH before committing Go changes.\n' >&2
  exit 1
fi

printf 'Running golangci-lint on the repository...\n'
golangci-lint run ./...
printf 'Linting passed.\n'
